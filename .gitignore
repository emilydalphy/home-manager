*.pyc
app/home_manager.db
app/home_manager.db-journal
.env

# Test artifacts
.pytest_cache/

# Local verification venv (Python 3.11 — the app requires 3.10+)
.venv-verify/

# Local venv (each worktree gets its own — see .claude/skills/home-manager-loop)
.venv

# Worktrees live inside the repo, so without this every parallel session's
# working copy shows up as untracked noise in `git status` on main.
.claude/worktrees/

# Local database snapshots (see app/backup.py). Real household data —
# never in git, same as the database itself.
backups/
app/backups/
