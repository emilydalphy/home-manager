<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. "development" is what Xcode writes;
	     an App Store / TestFlight export re-signs it as "production" from the
	     distribution provisioning profile, so this file does not change per
	     build. The server picks the matching APNs host with APNS_SANDBOX. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
