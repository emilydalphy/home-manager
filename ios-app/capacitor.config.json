{
  "appId": "com.heypomona.app",
  "appName": "Pomona",
  "webDir": "www",
  "backgroundColor": "#FFFAF3",
  "server": {
    "url": "https://app.heypomona.com",
    "errorPath": "offline.html"
  },
  "ios": {
    "scheme": "App",
    "appendUserAgent": "PomonaApp/1.0.0",
    "limitsNavigationsToAppBoundDomains": true,
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#FFFAF3"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#FFFAF3",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#FFFAF3"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
